import { useEffect, useState } from 'react';
import api from '../api';
import './InspectorDashboard.css';

function InspectorDashboard() {
  const [apps, setApps] = useState([]);
  const [selected, setSelected] = useState(null);
  const [notes, setNotes] = useState('');
  const [result, setResult] = useState('');
  const [error, setError] = useState('');

  useEffect(() => {
    const fetchApps = async () => {
      try {
        const res = await api.get('/api/applications');
        setApps(res.data);
      } catch {
        setError('Failed to fetch inspection tasks');
      }
    };
    fetchApps();
  }, [selected]);

  const startInspection = app => {
    setSelected(app);
    setNotes('');
    setResult('');
    setError('');
  };

  const submitInspection = async () => {
    if (!notes.trim()) {
      setError('Notes are required for inspection');
      return;
    }
    if (!result) {
      setError('Select inspection result');
      return;
    }
    try {
      await api.post(`/api/inspector/inspections/${selected.id}/add`,
        { notes, result },
        { params: { inspectorId: selected.assignedInspector?.id } }
      );
      setSelected(null);
    } catch {
      setError('Failed to submit inspection');
    }
  };

  return (
    <div className="inspector-dashboard-container">
      <h2>Inspector Dashboard</h2>
      {selected ? (
        <div className="inspection-details">
          <h3>Inspect Application {selected.id}</h3>
          <p><strong>Vendor:</strong> {selected.user?.email}</p>
          <p><strong>Status:</strong> {selected.status}</p>
          <textarea value={notes} onChange={e=>setNotes(e.target.value)} placeholder="Enter inspection notes"/>
          <select value={result} onChange={e=>setResult(e.target.value)}>
            <option value="">Select Result</option>
            <option value="PASSED">Passed</option>
            <option value="FAILED">Failed</option>
            <option value="FOLLOW_UP_REQUIRED">Follow Up Required</option>
          </select>
          <div className="actions">
            <button onClick={submitInspection}>Submit</button>
            <button onClick={()=>setSelected(null)}>Cancel</button>
          </div>
          {error && <p className="error">{error}</p>}
        </div>
      ) : (
        <table className="inspector-table">
          <thead><tr><th>ID</th><th>Vendor</th><th>Status</th><th>Submission</th><th></th></tr></thead>
          <tbody>
            {apps.filter(a => a.status==='INSPECTION_SCHEDULED')
              .map(a=>
                <tr key={a.id}>
                  <td>{a.id}</td>
                  <td>{a.user?.email}</td>
                  <td>{a.status}</td>
                  <td>{new Date(a.submissionDate).toLocaleString()}</td>
                  <td><button onClick={()=>startInspection(a)}>Inspect</button></td>
                </tr>)}
            {apps.length===0 && <tr><td colSpan="5">No inspections assigned</td></tr>}
          </tbody>
        </table>
      )}
    </div>
  );
}
export default InspectorDashboard;
