import { useEffect, useState } from 'react';
import api from '../api';
import './ReviewerDashboard.css';

function ReviewerDashboard() {
  const [applications, setApplications] = useState([]);
  const [selectedApp, setSelectedApp] = useState(null);
  const [comments, setComments] = useState('');
  const [status, setStatus] = useState('');
  const [error, setError] = useState('');

  useEffect(() => {
    const fetchApps = async () => {
      try {
        const res = await api.get('/api/applications');
        setApplications(res.data);
      } catch {
        setError('Failed to fetch applications.');
      }
    };
    fetchApps();
  }, [selectedApp]);

  const openApp = app => {
    setSelectedApp(app);
    setComments('');
    setStatus('');
    setError('');
  };

  const submitReview = async () => {
    if (!status) {
      setError('Select a review action.');
      return;
    }
    if (status === 'REJECTED' && !comments.trim()) {
      setError('Comments required when rejecting.');
      return;
    }
    try {
      await api.post(`/api/reviewer/reviews/${selectedApp.id}/add`, {
        status,
        comments
      }, { params: { reviewerId: selectedApp.assignedReviewer?.id } });
      setSelectedApp(null);
    } catch {
      setError('Failed to submit review.');
    }
  };

  return (
    <div className="reviewer-dashboard-container">
      <h2>Reviewer Dashboard</h2>
      {selectedApp ? (
        <div className="review-details">
          <h3>Application Details</h3>
          <p><b>Vendor:</b> {selectedApp.user?.email}</p>
          <p><b>Status:</b> {selectedApp.status}</p>
          <p><b>Submission:</b> {new Date(selectedApp.submissionDate).toLocaleString()}</p>
          <textarea placeholder="Enter comments (mandatory on rejection)"
              value={comments} onChange={e=>setComments(e.target.value)} />
          <div className="review-actions">
            <button onClick={()=>{setStatus('APPROVED'); submitReview();}}>Approve</button>
            <button onClick={()=>{setStatus('REJECTED'); submitReview();}}>Reject</button>
            <button onClick={()=>{setStatus('REQUEST_MORE_INFO'); submitReview();}}>Request Info</button>
            <button onClick={()=>setSelectedApp(null)}>Back</button>
          </div>
          {error && <p className="error">{error}</p>}
        </div>
      ):(
        <table className="reviewer-applications-table">
          <thead><tr><th>ID</th><th>Vendor</th><th>Status</th><th>Submission</th><th></th></tr></thead>
          <tbody>
            {applications.length===0 ? <tr><td colSpan="5">No assigned applications</td></tr>
              : applications.map(app=>
                <tr key={app.id}>
                  <td>{app.id}</td>
                  <td>{app.user?.email}</td>
                  <td>{app.status}</td>
                  <td>{new Date(app.submissionDate).toLocaleString()}</td>
                  <td><button onClick={()=>openApp(app)}>Review</button></td>
                </tr>)}
          </tbody>
        </table>
      )}
    </div>
  );
}
export default ReviewerDashboard;
