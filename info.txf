package com.examly.springapp.configuration;

import com.examly.springapp.repository.UserRepository;
import com.examly.springapp.repository.ApplicationRepository;
import com.examly.springapp.model.Application;
import com.examly.springapp.model.ApplicationStatus;
import com.examly.springapp.service.EmailService;
import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Component;

import java.time.LocalDateTime;
import java.util.List;

@Component
public class MaintenanceTasks {

    private final UserRepository userRepository;
    private final ApplicationRepository applicationRepository;
    private final EmailService emailService;

    public MaintenanceTasks(UserRepository userRepository,
                            ApplicationRepository appRepo,
                            EmailService emailService) {
        this.userRepository = userRepository;
        this.applicationRepository = appRepo;
        this.emailService = emailService;
    }

    // Clean up unverified accounts older than 7 days
    @Scheduled(cron = "0 0 2 * * ?")
    public void cleanUnverifiedAccounts() {
        userRepository.findAll().stream()
                .filter(u -> !u.isVerified())
                .forEach(userRepository::delete);
    }

    // Send renewal reminders for licenses expiring in 30 days
    @Scheduled(cron = "0 0 10 * * ?")
    public void sendRenewalReminders() {
        LocalDateTime now = LocalDateTime.now();
        LocalDateTime expiryThreshold = now.plusDays(30);
        List<Application> applications = applicationRepository.findAll();
        for (Application app : applications) {
            if (app.getStatus() == ApplicationStatus.LICENSE_ISSUED &&
                app.getLicenseExpiryDate() != null &&
                app.getLicenseExpiryDate().isBefore(expiryThreshold)) {
                emailService.sendSimpleMessage(
                    app.getUser().getEmail(),
                    "License Renewal Reminder",
                    "Your license " + app.getLicenseNumber() +
                    " will expire on " + app.getLicenseExpiryDate() +
                    ". Please renew in time."
                );
            }
        }
    }
}
