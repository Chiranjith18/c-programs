import { useState, useEffect } from 'react';
import { useNavigate } from 'react-router-dom';
import api from '../api';
import './DisplayFoodTruck.css';

function DisplayFoodTruck() {
    const [vendors, setVendors] = useState([]);
    const [loading, setLoading] = useState(false);
    const [error, setError] = useState('');
    const navigate = useNavigate();

    const fetchVendors = async () => {
    setLoading(true);
    setError('');
    try {
        // Call new endpoint returning plain array
        const response = await api.get('/api/vendors/all');
        setVendors(Array.isArray(response.data) ? response.data : []);
    } catch (err) {
        setError('Failed to fetch vendors. Please try again.');
        console.error("Error fetching vendors:", err);
        setVendors([]);
    } finally {
        setLoading(false);
    }
};


    const handleDelete = async (id) => {
        if (!window.confirm('Are you sure you want to delete this vendor?')) return;
        try {
            await api.delete(`/api/vendors/${id}`);
            fetchVendors();
        } catch (err) {
            console.error("Error deleting vendor:", err);
            alert('Failed to delete vendor');
        }
    };

    useEffect(() => {
        fetchVendors();
    }, []);

    return (
        <div className="vendor-container">
            {/* ✅ Heading updated to match test expectation */}
            <h2>Submitted Food Truck Vendor Applications</h2>

            {error && <div className="error-message">{error}</div>}

            {loading ? (
                <div className="loading">Loading...</div>
            ) : (
                <>
                    <table>
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Cuisine</th>
                                <th>Region</th>
                                <th>Menu Highlights</th>
                                <th>Phone</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {vendors.map(vendor => (
                                <tr key={vendor.id}>
                                    <td>{vendor.name}</td>
                                    <td>{vendor.cuisineSpecialties}</td>
                                    <td>{vendor.operatingRegion}</td>
                                    <td>{vendor.menuHighlights}</td>
                                    <td>{vendor.phoneNumber}</td>
                                    <td>
                                        <button 
                                            onClick={() => handleDelete(vendor.id)}
                                            className="delete-btn"
                                        >
                                            Delete
                                        </button>
                                    </td>
                                </tr>
                            ))}
                            {vendors.length === 0 && (
                                <tr>
                                    <td colSpan="6">No vendors available</td>
                                </tr>
                            )}
                        </tbody>
                    </table>
                </>
            )}
        </div>
    );
}

export default DisplayFoodTruck;
