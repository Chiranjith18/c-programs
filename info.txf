import { useState, useEffect } from 'react';
import { useNavigate } from 'react-router-dom';
import api from '../api';
import './ApplyForm.css';

function ApplyForm() {
  const [formData, setFormData] = useState({ name:'', cuisineSpecialties:'', operatingRegion:'', menuHighlights:'', phoneNumber:'' });
  const [errors, setErrors] = useState({});
  const [loadingProfile, setLoading] = useState(true);
  const [showSuccess, setShowSuccess] = useState(false);
  const navigate = useNavigate();

  useEffect(()=>{
    api.get('/api/vendors/me')
      .then(res => setFormData(res.data))
      .catch(()=>{})
      .finally(()=>setLoading(false));
  },[]);

  const validate = () => {
    const err={};
    if (!formData.name.trim()) err.name="Name required";
    if (!formData.operatingRegion) err.operatingRegion="Region required";
    if (!/^[6-9]\d{9}$/.test(formData.phoneNumber)) err.phoneNumber="Invalid phone number";
    return err;
  };

  const handleSubmit = async e => {
    e.preventDefault();
    const err = validate();
    if (Object.keys(err).length) { setErrors(err); return; }
    try {
      await api.post('/api/vendors', formData);
      await api.post('/api/applications/submit', {});
      setShowSuccess(true);
      setTimeout(()=>navigate('/vendor/dashboard'),2000);
    } catch { alert("Failed, check profile/application"); }
  };

  if (loadingProfile) return <p>Loading...</p>;
  if (showSuccess) return <div className="success-modal"><div className="success-modal-content"><h3>Application submitted!</h3></div></div>;

  return (
    <div className="form-container">
      <h2>Apply to Become a Food Truck Vendor</h2>
      <form onSubmit={handleSubmit}>
        <label>Name:</label><input value={formData.name} onChange={e=>setFormData({...formData,name:e.target.value})}/>
        <label>Cuisine Specialties:</label><input value={formData.cuisineSpecialties} onChange={e=>setFormData({...formData,cuisineSpecialties:e.target.value})}/>
        <label>Region:</label>
        <select value={formData.operatingRegion} onChange={e=>setFormData({...formData,operatingRegion:e.target.value})}>
          <option value="">Select</option>
          <option value="Chennai">Chennai</option>
          <option value="Bangalore">Bangalore</option>
        </select>
        <label>Menu:</label><textarea value={formData.menuHighlights} onChange={e=>setFormData({...formData,menuHighlights:e.target.value})}/>
        <label>Phone:</label><input value={formData.phoneNumber} onChange={e=>setFormData({...formData,phoneNumber:e.target.value})}/>
        <button className="submit-btn">Submit</button>
      </form>
    </div>
  );
}
export default ApplyForm;
